{
  "info": {
    "name": "Digital Dean Practice 05",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "test_login",
      "value": ""
    },
    {
      "key": "user_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Register active user",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/users",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman Test Student\",\n  \"email\": \"{{test_login}}@example.com\",\n  \"login\": \"{{test_login}}\",\n  \"password\": \"PostmanTest!2026\",\n  \"status_id\": 1\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"test_login\", \"p5_\" + Date.now() + \"_\" + Math.floor(Math.random()*10000));",
              "pm.collectionVariables.unset(\"user_id\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "pm.test(\"Active status\", function () { pm.expect(pm.response.json().status_id).to.eql(1); });",
              "pm.test(\"No secrets\", function () { pm.expect(pm.response.json()).not.to.have.property(\"password\"); pm.expect(pm.response.json()).not.to.have.property(\"salt\"); });",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"user_id\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Duplicate registration",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/users",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman Test Student\",\n  \"email\": \"{{test_login}}@example.com\",\n  \"login\": \"{{test_login}}\",\n  \"password\": \"PostmanTest!2026\",\n  \"status_id\": 1\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", function () { pm.response.to.have.status(409); });"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Login active user",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"login\": \"{{test_login}}\",\n  \"password\": \"PostmanTest!2026\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Login true\", function () { pm.expect(pm.response.json()).to.eql(true); });"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Wrong password",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"login\": \"{{test_login}}\",\n  \"password\": \"wrong\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Login false\", function () { pm.expect(pm.response.json()).to.eql(false); });"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Invalid registration",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/users",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman Test Student\",\n  \"email\": \"{{test_login}}@example.com\",\n  \"login\": \"{{test_login}}\",\n  \"password\": \"short\",\n  \"status_id\": 1\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 422\", function () { pm.response.to.have.status(422); });"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Block user",
      "request": {
        "method": "PATCH",
        "header": [],
        "url": "{{base_url}}/api/v1/users/{{user_id}}/block"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Blocked status\", function () { pm.expect(pm.response.json().status_id).to.eql(2); });"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Repeat block",
      "request": {
        "method": "PATCH",
        "header": [],
        "url": "{{base_url}}/api/v1/users/{{user_id}}/block"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Still blocked\", function () { pm.expect(pm.response.json().status_id).to.eql(2); });"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Login blocked user",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"login\": \"{{test_login}}\",\n  \"password\": \"PostmanTest!2026\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Login false\", function () { pm.expect(pm.response.json()).to.eql(false); });"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Delete user",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{base_url}}/api/v1/users/{{user_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 204\", function () { pm.response.to.have.status(204); });",
              "pm.test(\"Empty body\", function () { pm.expect(pm.response.text()).to.eql(\"\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "10 Delete missing user",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{base_url}}/api/v1/users/{{user_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", function () { pm.response.to.have.status(404); });"
            ]
          }
        }
      ]
    },
    {
      "name": "11 Block missing user",
      "request": {
        "method": "PATCH",
        "header": [],
        "url": "{{base_url}}/api/v1/users/{{user_id}}/block"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", function () { pm.response.to.have.status(404); });"
            ]
          }
        }
      ]
    },
    {
      "name": "12 Login deleted user",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"login\": \"{{test_login}}\",\n  \"password\": \"PostmanTest!2026\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Login false\", function () { pm.expect(pm.response.json()).to.eql(false); });"
            ]
          }
        }
      ]
    }
  ]
}