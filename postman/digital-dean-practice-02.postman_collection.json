      "name": "01 Health",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('service is ready', () => pm.expect(pm.response.json()).to.eql({status: 'ok'}));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/health",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "response": []
    },
    {
      "name": "02 Create synthetic student",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('student_id', '');",
              "pm.collectionVariables.set('note_id', '');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 201', () => pm.response.to.have.status(201));",
              "pm.test('response has id', () => pm.expect(pm.response.json().id).to.be.a('string'));",
              "if (pm.response.code === 201) pm.collectionVariables.set('student_id', pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"full_name\": \"Олена Коваль\",\n  \"email\": \"practice02-{{$guid}}@example.com\",\n  \"group_code\": \"КН-31\",\n  \"study_program\": \"Комп'ютерні науки\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/v1/students",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "students"
          ]
        }
      },
      "response": []
    },
    {
      "name": "03 Create protected note",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('student_id')) throw new Error('Create student first');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('note metadata without internal fields', () => {",
              "  pm.response.to.have.status(201);",
              "  const body = pm.response.json();",
              "  pm.expect(body.id).to.be.a('string');",
              "  pm.expect(body.student_id).to.eql(pm.collectionVariables.get('student_id'));",
              "  pm.expect(body.algorithm).to.eql('AES-256-GCM');",
              "  ['text', 'key', 'key_id', 'nonce', 'ciphertext', 'tag'].forEach(field => pm.expect(body).not.to.have.property(field));",
              "});",
              "if (pm.response.code === 201) pm.collectionVariables.set('note_id', pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"{{note_text}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/v1/students/{{student_id}}/secure-notes",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "students",
            "{{student_id}}",
            "secure-notes"
          ]
        }
      },
      "response": []
    },
    {
      "name": "04 Read verified note",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('note_id')) throw new Error('Create note first');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('verified text is preserved exactly', () => {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  pm.expect(body.id).to.eql(pm.collectionVariables.get('note_id'));",
              "  pm.expect(body.student_id).to.eql(pm.collectionVariables.get('student_id'));",
              "  pm.expect(body.text).to.eql(pm.collectionVariables.get('note_text'));",
              "  ['key', 'key_id', 'nonce', 'ciphertext', 'tag'].forEach(field => pm.expect(body).not.to.have.property(field));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/students/{{student_id}}/secure-notes/{{note_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "students",
            "{{student_id}}",
            "secure-notes",
            "{{note_id}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "09 Update protected note",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('note_id')) throw new Error('Create note first');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"PATCH status is 200\", function () {\n    pm.response.to.have.status(200);\n});\n\npm.test(\"Metadata without plaintext\", function () {\n    const data = pm.response.json();\n    pm.expect(data).to.have.property(\"id\");\n    pm.expect(data).not.to.have.property(\"text\");\n    pm.expect(data).not.to.have.property(\"key\");\n});\nif (pm.response.code === 200) {\n    pm.collectionVariables.set(\n        \"note_text\",\n        \"Оновлена захищена примітка\"\n    );\n}"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"text\": \"Оновлена захищена примітка\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/v1/students/{{student_id}}/secure-notes/{{note_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "students",
            "{{student_id}}",
            "secure-notes",
            "{{note_id}}"
          ]
        }
      },
      "response": []
    },
